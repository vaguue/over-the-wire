{
  "source": {
    "include": [
      "lib",
      "lib/layers",
      "lib/pcapFile/index.js"
    ],
    "exclude": [
      "lib/checks"
    ],
    "includePattern": ".js$",
    "excludePattern": "(node_modules/|docs)"
  },
  "opts": {
    "destination": "./docs",
    "template": "node_modules/clean-jsdoc-theme",
    "readme": "./README.md",
    "tutorials": "./recipes",
    "theme_opts": {
      "sections": [
        "Tutorials",
        "Classes",
        "Modules",
        "Namespaces",
        "Global"
      ],
      "title": "over-the-wire"
    }
  },
  "plugins": [
    "jsdoc-plugins/packet-methods.cjs"
  ]
}
