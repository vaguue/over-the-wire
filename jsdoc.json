{
  "source": {
    "include": ["lib", "lib/layers", "lib/pcapFile/index.js"],
    "exclude": ["lib/checks"],
    "includePattern": ".js$",
    "excludePattern": "(node_modules/|docs)"
  },
  "opts": {
    "destination": "./docs",
    "template": "node_modules/clean-jsdoc-theme",
    "readme": "./README.md"
  },
  "plugins": ["jsdoc-plugins/packet-methods"]
}
