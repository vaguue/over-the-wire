{
  "name": "over-the-wire",
  "version": "2.0.0",
  "description": "Network inspection library for Node",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "otw": "bin/otw.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vaguue/over-the-wire.git"
  },
  "homepage": "https://vaguue.github.io/over-the-wire/",
  "bugs": {
    "url": "https://github.com/vaguue/over-the-wire/issues"
  },
  "author": "Seva D. <sabrinarempel7@gmail.com>",
  "scripts": {
    "install": "node scripts/install.js",
    "rebuild-debug": "cross-env CMAKE_POLICY_VERSION_MINIMUM=3.5 cmake-js compile -D",
    "build-debug": "cross-env CMAKE_POLICY_VERSION_MINIMUM=3.5 cmake-js build -D",
    "rebuild": "cross-env CMAKE_POLICY_VERSION_MINIMUM=3.5 cmake-js compile",
    "precompile": "node scripts/prebuild.js",
    "build": "cross-env CMAKE_POLICY_VERSION_MINIMUM=3.5 cmake-js build",
    "test": "node --test test/*.test.js",
    "test-cov-text": "node --test --experimental-test-coverage test/*.test.js",
    "test-cov": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=lcov.info test/*.test.js",
    "generate-docs": "jsdoc --configure jsdoc.json --verbose"
  },
  "imports": {
    "#lib/*": "./lib/*.js"
  },
  "keywords": [
    "security",
    "pcap",
    "network",
    "packet-analyser",
    "packet-sniffer",
    "network-discovery",
    "network-analysis",
    "packet-crafting",
    "packet-capture",
    "network-security",
    "security-tools"
  ],
  "license": "ISC",
  "dependencies": {
    "@vaguuue/prebuild-install": "^7.1.2",
    "bindings": "^1.5.0",
    "cmake-js": "^7.3.0",
    "node-addon-api": "^8.3.1",
    "struct-compile": "^2.0.0",
    "yargs": "^17.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "CMakeLists.txt",
    "cxx_modules",
    "cxx",
    "assets",
    "bin",
    "lib",
    "test",
    "recipes",
    "scripts"
  ],
  "devDependencies": {
    "clean-jsdoc-theme": "^4.3.0",
    "cross-env": "^10.1.0",
    "jsdoc": "^4.0.4"
  }
}
